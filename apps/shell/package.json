{
  "name": "@office-cc/shell",
  "productName": "Office-cc",
  "version": "0.0.2",
  "license": "Apache-2.0",
  "homepage": "https://github.com/dcc123456/genoffice",
  "private": true,
  "description": "Unified Office-cc shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "officecc.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@office-cc/agent-core": "*",
    "@office-cc/ai-provider": "*",
    "@office-cc/ai-search": "*",
    "@office-cc/docs": "*",
    "@office-cc/docx-engine": "*",
    "@office-cc/electron-utils": "*",
    "@office-cc/cli": "*",
    "@office-cc/i18n": "*",
    "@office-cc/pipelines": "*",
    "@office-cc/pptx-engine": "*",
    "@office-cc/pptx-render": "*",
    "@office-cc/sheets": "*",
    "@office-cc/slides": "*",
    "@office-cc/ui": "*",
    "@office-cc/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "Office-cc"
}
