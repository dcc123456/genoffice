{
  "name": "@office-cc/cli",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "officecc: the Office-cc command line (create, convert, read, edit and render documents) built on the same engines as the app; runs headless on the app's bundled Node runtime",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./agent-skills": "./src/agent-skills.ts",
    "./mcp-launch": "./src/mcp-launch.ts",
    "./control-protocol": "./src/control-protocol.ts"
  },
  "bin": {
    "officecc": "./bin/officecc"
  },
  "scripts": {
    "build": "node build.mjs && node collect-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@office-cc/ai-provider": "*",
    "@office-cc/ai-search": "*",
    "@office-cc/docx-engine": "*",
    "@office-cc/odf2ooxml": "*",
    "@office-cc/pdf2docx": "*",
    "@office-cc/pipelines": "*",
    "@office-cc/pptx-engine": "*",
    "@office-cc/pptx-ops": "*",
    "@office-cc/pptx-render": "*",
    "@office-cc/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tiptap/core": "3.31.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "pngjs": "^7.0.0",
    "undici": "^6.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
